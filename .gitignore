.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
.opencode/**/node_modules/

# DeepWorks 运行时目录（会话临时数据，不入库）
.opencode/deepworks/
.opencode/inbox/
.opencode/outbox/
.opencode/previews/

# ---------- DeepWorks / opencode 工具自身配置（不属于主页内容，公开仓库不包含） ----------
# 这些文件是 AI 开发工具的工作配置（含本地绝对路径、工具提示词等），
# 与「个人主页」这个项目本身无关，因此不进入公开仓库；文件仍保留在本地磁盘。
.opencode/
opencode.jsonc

# ---------- 本轮会话临时文件 ----------
.deepworks/
*.log

# 会话中上传/落盘的临时素材（参考图等，不随仓库分发）
uploads/

# ---------- 本地密钥与运行时（切勿提交） ----------
.env
.env.local
__pycache__/
*.pyc

# ---------- Supabase CLI 本地状态与工具 ----------
# supabase/functions/** 必须入库（函数源码要随仓库发布），只忽略 CLI 的本地缓存与下载的二进制
supabase/.temp/
supabase/.branches/
tools/bin/

# ---------- 系统与编辑器 ----------
.DS_Store
Thumbs.db
.vscode/
.idea/

