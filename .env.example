# ============================================================
#  个人主页 · 环境变量示例
# ============================================================
# 使用方法：
#   1. 把本文件复制一份并重命名为 .env（不要提交到 Git！）
#   2. 按需填写下面的配置（两节可以只填其中一节）
#   3. 运行：py server.py
# ============================================================

# ============================================================
#  一、数字分身（DeepSeek）
# ============================================================
# 获取密钥：https://platform.deepseek.com/  → API Keys
DEEPSEEK_API_KEY=

# ---------- 以下均为可选，留空则使用默认值 ----------
# 模型名称（默认 deepseek-chat；也可用 deepseek-reasoner）
# DEEPSEEK_MODEL=deepseek-chat

# 接口地址（一般无需修改）
# DEEPSEEK_API_BASE=https://api.deepseek.com/chat/completions

# 单次回复的最大 token 数（默认 800）
# DEEPSEEK_MAX_TOKENS=800

# 随机性 0~2，越大越发散（默认 0.7）
# DEEPSEEK_TEMPERATURE=0.7

# 请求超时秒数（默认 60）
# DEEPSEEK_TIMEOUT=60

# ============================================================
#  二、意见反馈（Supabase）
# ============================================================
# 启用步骤：
#   1. 在 Supabase 控制台的 SQL Editor 里执行 sql/feedback.sql 建表
#   2. 到 Project Settings → API Keys 复制下面两项
#   3. 密钥用 anon / publishable key 即可。
#      数据库侧只放行了「匿名插入」，所以这个密钥即使泄露，
#      别人也只能提交新反馈，读不到你收到的内容。
#
# Project URL，形如 https://xxxxxxxx.supabase.co
SUPABASE_URL=

# anon / publishable key，形如 eyJ... 或 sb_publishable_...
SUPABASE_KEY=

# 表名（默认 feedback，需与建表 SQL 一致）
# SUPABASE_TABLE=feedback

# 写入超时秒数（默认 20）
# SUPABASE_TIMEOUT=20

# ============================================================
#  三、本地服务
# ============================================================
# 监听地址与端口（默认 127.0.0.1:8000）
# HOST=127.0.0.1
# PORT=8000
